---
import type { CollectionEntry } from "astro:content";
import { route, translate } from "../i18n";
const { entry } = Astro.props as { entry: CollectionEntry<"projects"> };
const p = entry.data;
---

<article class:list={["project-card", p.theme]}>
  <a class="project-link" href={route(p.lang, "projects", p.slug)}>
    <img
      src={p.cover ?? `/images/projects/${p.slug}/cover.svg`}
      width="520"
      height="260"
      alt=""
      loading="lazy"
    />
    <div class="card-copy">
      <div class="project-meta mono">
        <span>{p.category}</span>
        <time datetime={String(p.year)}>{p.year}</time>
      </div>
      <h3>{p.title}</h3>
      <p>{p.description}</p>
      <div class="tags">
        {p.technologies.slice(0, 4).map((item) => (
          <span>{item}</span>
        ))}
      </div>
      <span class="card-cta">
        {translate(p.lang, "Leer caso de estudio", "Read case study")}
      </span>
    </div>
  </a>
</article>
